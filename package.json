{
  "name": "traytune",
  "private": true,
  "version": "0.1.2",
  "description": "Local-first Windows 11-style music player that lives in the system tray",
  "author": "Muzammil-Noor",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc -b && electron-vite build",
    "start": "electron-vite preview",
    "lint": "eslint .",
    "package:win": "npm run build && electron-builder --win --publish never"
  },
  "//": "Everything is a devDependency on purpose: electron-vite bundles all runtime code into out/, so the packaged app needs no node_modules. Anything added to \"dependencies\" gets copied into the installer verbatim.",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "music-metadata": "^11.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6"
  }
}
